# Copy to .env before running. These are the exact settings the reported
# 90-claim run used.
#
# Local, free backend. No API key needed.
FACTCHECK_PROVIDER=ollama
FACTCHECK_MODEL=qwen2.5:3b
OLLAMA_HOST=http://localhost:11434
FACTCHECK_NUM_CTX=8192

# Keep the auditor prompt small for a 3B model.
FACTCHECK_RESULTS_PER_QUERY=3
FACTCHECK_MAX_EVIDENCE=4

# Optional hosted backend. Leave unset to stay fully local.
# FACTCHECK_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
