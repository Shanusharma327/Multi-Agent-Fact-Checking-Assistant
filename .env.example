# ---------------------------------------------------------------------------
# Model backend: "ollama" (local, free) or "anthropic" (hosted, paid).
# If unset, the app picks "anthropic" when ANTHROPIC_API_KEY exists, else
# "ollama".
# ---------------------------------------------------------------------------
FACTCHECK_PROVIDER=ollama

# --- Local (Ollama) -------------------------------------------------------
# Install from https://ollama.com, then: ollama pull qwen2.5:7b
FACTCHECK_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434
# Ollama defaults to a 2048-token context, which truncates the auditor prompt.
FACTCHECK_NUM_CTX=8192

# --- Hosted (Anthropic) ---------------------------------------------------
# Only needed when FACTCHECK_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-...
# FACTCHECK_MODEL=claude-opus-5

# --- Retrieval (both backends) --------------------------------------------
FACTCHECK_RESULTS_PER_QUERY=4
# Lower this (4 or so) for small local models: fewer snippets keeps the
# auditor prompt inside a modest context window.
FACTCHECK_MAX_EVIDENCE=8
